{
  "info": {
    "name": "HackHub - Hackathon module",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "hackathonId", "value": "1" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/health" }
    },
    {
      "name": "List approved hackathons",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/hackathons" }
    },
    {
      "name": "List notifications",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{organiserToken}}" }],
        "url": "{{baseUrl}}/api/notifications"
      }
    },
    {
      "name": "Export participants",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{organiserToken}}" }],
        "url": "{{baseUrl}}/api/hackathons/{{hackathonId}}/participants/export"
      }
    }
  ]
}
