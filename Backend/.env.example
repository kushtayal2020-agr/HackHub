# ========================================================
# HackHub Environment Configuration Template
# Duplicate this file to .env and adjust variables for your target environment.
# ========================================================

# Application Port
PORT=5000
NODE_ENV=production

# MySQL 8.0 Database Connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=hackhub_user
DB_PASSWORD=your_secure_database_password
DB_NAME=hackhub

# JWT Signing Secret (Minimum 64-character cryptographic string)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_key_here

# Allowed Frontend Origins (Comma-separated)
FRONTEND_URL=http://localhost:5500,http://127.0.0.1:5500,https://hackhub.yourdomain.com
